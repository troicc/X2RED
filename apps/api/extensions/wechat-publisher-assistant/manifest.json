{
  "manifest_version": 3,
  "name": "X2RED 公众号发布助手",
  "version": "0.10.0",
  "description": "安全地将 X2RED 已审阅的公众号标题、作者和内联富文本写入公众号编辑器。",
  "permissions": ["activeTab", "tabs", "clipboardWrite", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://mp.weixin.qq.com/*"
  ],
  "action": {
    "default_title": "X2RED 公众号发布助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
