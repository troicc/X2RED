X2RED_DATABASE_URL=sqlite:///./data/x2red.db
X2RED_FXTWITTER_BASE_URL=https://api.fxtwitter.com
X2RED_MEDIA_DIR=./data/assets
X2RED_RAW_DIR=./data/raw
X2RED_EXPORT_DIR=./data/exports
X2RED_BROWSER_PROFILE_DIR=./data/profiles/xhs
X2RED_NATIVE_SKILL_DIR=./data/native-skills
X2RED_DOWNLOAD_MEDIA=true
X2RED_MAX_MEDIA_BYTES=209715200

# OpenAI-compatible text model endpoint.
X2RED_MODEL_BASE_URL=
X2RED_MODEL_API_KEY=
X2RED_MODEL_NAME=

# Optional OpenAI-compatible image-generation endpoint.
X2RED_IMAGE_BASE_URL=
X2RED_IMAGE_API_KEY=
X2RED_IMAGE_MODEL=
X2RED_IMAGE_SIZE=1024x1536
# production | skill_v03 | legacy
X2RED_MINIMAL_ZINE_PROMPT_MODE=production
X2RED_VISUAL_BRIEF_MODE=production
X2RED_IMAGE_CANDIDATE_MODE=production
X2RED_IMAGE_CANDIDATE_COUNT=3
X2RED_TYPOGRAPHY_RECIPE_MODE=production
# hybrid | legacy
X2RED_EVIDENCE_RETRIEVAL_MODE=hybrid
# Optional OpenAI-compatible embeddings. Leave empty for local BM25.
X2RED_EVIDENCE_EMBEDDING_BASE_URL=
X2RED_EVIDENCE_EMBEDDING_API_KEY=
X2RED_EVIDENCE_EMBEDDING_MODEL=
# production | legacy
X2RED_WRITING_SCHEMA_MODE=production
# production | legacy
X2RED_WRITING_QUALITY_MODE=production

# Model reliability and usage/cost telemetry. Prices are USD per one million
# tokens; leave them at 0 when the provider reports cost directly or the price
# is unknown. Unknown cost is shown as unavailable, never as a fake estimate.
X2RED_REQUEST_TIMEOUT_SECONDS=20
X2RED_MODEL_MAX_RETRIES=2
X2RED_MODEL_RETRY_BASE_SECONDS=0.5
X2RED_MODEL_RETRY_MAX_SECONDS=8
X2RED_MODEL_RETRY_JITTER_SECONDS=0.25
X2RED_MODEL_INPUT_COST_PER_MILLION_USD=0
X2RED_MODEL_OUTPUT_COST_PER_MILLION_USD=0
X2RED_IMAGE_COST_PER_IMAGE_USD=0

# Durable background-job lease and retry policy.
X2RED_JOB_LEASE_SECONDS=90
X2RED_JOB_HEARTBEAT_SECONDS=20
X2RED_JOB_RETRY_BASE_SECONDS=2

# Local API protection. Loopback is the default. Set a strong token before a
# non-loopback bind; list additional trusted browser origins as comma-separated
# absolute origins. The insecure override is an explicit emergency escape hatch.
X2RED_LOCAL_API_TOKEN=
X2RED_ALLOWED_ORIGINS=
X2RED_ALLOW_INSECURE_NON_LOOPBACK=false

# Simplified-Chinese material discovery: MediaCrawler only.
X2RED_MATERIAL_SEARCH_PROVIDER=mediacrawler
X2RED_MEDIACRAWLER_ROOT=./.vendor/MediaCrawler
X2RED_MEDIACRAWLER_PYTHON=
X2RED_MEDIACRAWLER_REVISION=1779dde9725f6b7ef42e29022c0054b3e678f1af
X2RED_MEDIACRAWLER_PLATFORM=xhs
X2RED_MEDIACRAWLER_LOGIN_TYPE=qrcode
X2RED_MEDIACRAWLER_CONNECT_EXISTING=true
X2RED_MEDIACRAWLER_CDP_PORT=9222
X2RED_MEDIACRAWLER_TIMEOUT_SECONDS=600
X2RED_MEDIACRAWLER_MAX_RESULTS=30

# Manual import for ordinary public web pages only.
X2RED_MATERIAL_EXTRACT_PROVIDER=direct
X2RED_MATERIAL_USER_AGENT=X2RED-MaterialResearch/0.13 (+local research)
X2RED_MATERIAL_MIN_INTERVAL_SECONDS=2
X2RED_MATERIAL_MAX_PAGE_BYTES=5242880
X2RED_MATERIAL_BROWSER_ENABLED=true
X2RED_MATERIAL_BROWSER_TIMEOUT_SECONDS=40
X2RED_MATERIAL_BROWSER_WAIT_MS=1800

# Low-cost local scheduler and signal-analysis policy.
X2RED_SCHEDULER_ENABLED=true
X2RED_SCHEDULER_TIMEZONE=Asia/Shanghai
X2RED_SCHEDULER_POLL_SECONDS=30
X2RED_SCHEDULER_BATCH_SIZE=20
X2RED_AUTO_L1_GRADES=T1,T2,T3
X2RED_AUTO_L2_GRADES=T2,T3
X2RED_AUTO_L2_DAILY_LIMIT=5
