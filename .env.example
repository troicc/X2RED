X2RED_DATABASE_URL=sqlite:///./data/x2red.db
X2RED_FXTWITTER_BASE_URL=https://api.fxtwitter.com
X2RED_MEDIA_DIR=./data/assets
X2RED_RAW_DIR=./data/raw
X2RED_EXPORT_DIR=./data/exports
X2RED_BROWSER_PROFILE_DIR=./data/profiles/xhs
X2RED_NATIVE_SKILL_DIR=./data/native-skills
X2RED_DOWNLOAD_MEDIA=true
X2RED_MAX_MEDIA_BYTES=209715200

# OpenAI-compatible text model endpoint. GLM can use the normal /api/paas/v4 endpoint.
X2RED_MODEL_BASE_URL=
X2RED_MODEL_API_KEY=
X2RED_MODEL_NAME=

# Optional OpenAI-compatible image-generation endpoint for the native Minimal Zine Skill.
# When the image endpoint shares the text provider, IMAGE_BASE_URL/API_KEY may be left empty.
# Example model for a compatible Zhipu endpoint: glm-image
X2RED_IMAGE_BASE_URL=
X2RED_IMAGE_API_KEY=
X2RED_IMAGE_MODEL=
X2RED_IMAGE_SIZE=1024x1536

# Simplified-Chinese material discovery. Auto prefers Baidu providers, then Tavily,
# Brave and finally GDELT. Configure any one commercial provider to enable it.
X2RED_MATERIAL_SEARCH_PROVIDER=auto
X2RED_SERPAPI_API_KEY=
X2RED_SERPAPI_BASE_URL=https://serpapi.com/search.json
X2RED_DATAFORSEO_LOGIN=
X2RED_DATAFORSEO_PASSWORD=
X2RED_DATAFORSEO_BASE_URL=https://api.dataforseo.com
X2RED_TAVILY_API_KEY=
X2RED_TAVILY_BASE_URL=https://api.tavily.com
X2RED_TAVILY_SEARCH_DEPTH=basic
X2RED_BRAVE_SEARCH_API_KEY=
X2RED_BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# Public-page extraction. Normal HTTP is attempted first; Playwright is used only
# when the public HTML does not contain enough article text.
X2RED_MATERIAL_USER_AGENT=X2RED-MaterialResearch/0.11 (+local research; public pages)
X2RED_MATERIAL_MIN_INTERVAL_SECONDS=2
X2RED_MATERIAL_MAX_PAGE_BYTES=5242880
X2RED_MATERIAL_BROWSER_ENABLED=true
X2RED_MATERIAL_BROWSER_TIMEOUT_SECONDS=40
X2RED_MATERIAL_BROWSER_WAIT_MS=1800
X2RED_MATERIAL_GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Low-cost local scheduler and signal-analysis policy.
X2RED_SCHEDULER_ENABLED=true
X2RED_SCHEDULER_TIMEZONE=Asia/Shanghai
X2RED_SCHEDULER_POLL_SECONDS=30
X2RED_SCHEDULER_BATCH_SIZE=20
X2RED_AUTO_L1_GRADES=T1,T2,T3
X2RED_AUTO_L2_GRADES=T2,T3
X2RED_AUTO_L2_DAILY_LIMIT=5
