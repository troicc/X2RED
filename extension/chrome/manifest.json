{
  "manifest_version": 3,
  "name": "Send to X2RED",
  "version": "0.1.0",
  "description": "Open the current X post in the local X2RED editorial inbox.",
  "permissions": ["contextMenus", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Send to X2RED"
  }
}
